#: ../source/docs/software-framework/LoRa-LoRaWan/index.rst:93
#: f87bf027fafe4356b66f08ed6a7d135f
msgid "\"答：不支持二次开发"
msgstr "A: Secondary development is not supported."

#: 16f642e206b0455588b2c0772cae3fed
#: ../source/docs/software-framework/LoRa-LoRaWan/index.rst:96
msgid "LoRa测试板底座的功能是什么"
