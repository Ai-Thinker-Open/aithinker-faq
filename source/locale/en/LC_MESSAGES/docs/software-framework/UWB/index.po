msgstr "What is the positioning accuracy of BU01?"

#: 370c6246944545d8908b95258ba8e5df
#: ../source/docs/software-framework/UWB/index.rst:70
msgid "+-10cm"
msgstr "+-10 cm."

#: 54fc9555e189409f8cedd64fe4c69d06
