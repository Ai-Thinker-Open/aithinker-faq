#: ../source/docs/software-framework/UWB/index.rst:548
#: cebfc06228df4f7da9dfa5c354894de9
msgid "可以"
msgstr "Yes."

#: 3f06d88ce78048859db3d8729e858e41 5445f208ba51428fb5bd8fa50fe97ca2
